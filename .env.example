# Copy this file to `.env` and fill in the secrets. `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Microsoft Foundry (Azure OpenAI) - GPT-5.4 baseline
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ---------------------------------------------------------------------------
# TypeSafe AI - Jev (https://console.typesafe.ai/keys)
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=<your-typesafe-key>
# Pin a versioned model for reproducible benchmarks (aliases: jev-latest, jev-preview)
JEV_MODEL=jev-1.14.0
# Optional: route Jev through a compatible gateway (then use the gateway key above), e.g.
# TYPESAFE_BASE_URL=https://openrouter.ai/api   with   JEV_MODEL=jev-1.13

# GPT-5.4 mini needs no extra setting: it is the Foundry deployment "gpt-5.4-mini" on the same
# resource, used by the system "gpt-5.4-mini-none".
